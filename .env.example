# API Configuration
# This is the public API key for authenticating with the backend
# Contact your backend team to get this key
VITE_PUBLIC_API_KEY=your_api_key_here

# Google OAuth Configuration
#
# Setup Instructions:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID (or edit existing one)
# 3. Configure the following settings:
#
#    Application type: Web application
#
#    Authorized JavaScript origins (REQUIRED - these are what matter for popup flow):
#      Development:
#        - http://localhost:3000
#        - http://127.0.0.1:3000
#      (Add both localhost and 127.0.0.1 to avoid issues)
#
#    Authorized redirect URIs (add these as well):
#      Development:
#        - http://localhost:3000
#        - http://127.0.0.1:3000
#        - http://localhost:3000/
#        - http://127.0.0.1:3000/
#
#    Production (when deploying):
#      Authorized JavaScript origins:
#        - https://yourdomain.com
#      Authorized redirect URIs:
#        - https://yourdomain.com
#        - https://yourdomain.com/
#
# 4. Copy the public Client ID below. Never put an OAuth client secret in a Vite frontend.
# 5. IMPORTANT: After adding the Client ID, restart your dev server (npm run dev)
# Any Google OAuth client secret belongs on a secure backend, never in VITE_ variables.
VITE_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Stripe client-side publishable key (pk_test_... / pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
